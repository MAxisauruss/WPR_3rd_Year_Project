<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact</title>
    <link rel="stylesheet" href="/Style/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body>

<%- include('partials/nav') %>

<div class="container">

    <div class="form-container">

        <h2>Contact Us</h2>

        <form id="contactForm">
    <div class="form-group">
        <label>Name</label>
        <input type="text" id="name" name="name" required>
    </div>
    <div class="form-group">
        <label>Email</label>
        <input type="email" id="email" name="email" required>
    </div>
    <div class="form-group">
        <label>Subject</label>
        <input type="text" id="subject" name="subject" required>
    </div>
    <div class="form-group">
        <label>Message</label>
        <textarea id="message" name="message" rows="5" required></textarea>
    </div>
    <button type="submit" class="btn">Send Message</button>
</form>

<div id="messageBox" style="margin-top: 15px; text-align: center; font-weight: bold;"></div>

<script>
    document.getElementById('contactForm').addEventListener('submit', async function(e) {
        e.preventDefault(); 
        const formData = {
            name: document.getElementById('name').value,
            email: document.getElementById('email').value,
            subject: document.getElementById('subject').value,
            message: document.getElementById('message').value
        };

        const messageBox = document.getElementById('messageBox');
        messageBox.style.color = "#06B6D4";
        messageBox.innerText = "Sending message...";

        // In contact.ejs inside the <script> block
try {
    // UPDATED URL: Now points to our consolidated contact router
    const response = await fetch('/contact/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(formData)
    });
    // ... rest of your script
            const data = await response.json();

            if (data.success) {
                messageBox.style.color = "#28a745"; // Green success
                messageBox.innerText = "Message sent successfully!";
                document.getElementById('contactForm').reset();
            } else {
                messageBox.style.color = "#dc3545"; // Red error
                messageBox.innerText = "Error: " + data.error;
            }
        } catch (error) {
            messageBox.style.color = "#dc3545";
            messageBox.innerText = "Server error. Please try again later.";
        }
    });
</script>

    </div>

</div>

<footer>
    <p>Smart Event Platform © 2026</p>
</footer>

</body>
</html>